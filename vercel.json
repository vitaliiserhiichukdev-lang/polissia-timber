{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/products/oak-parquet-boards",
      "destination": "/products/oak-chevron-parquet",
      "permanent": true
    },
    {
      "source": "/:locale(de|pl|uk)/products/oak-parquet-boards",
      "destination": "/:locale/products/oak-chevron-parquet",
      "permanent": true
    },
    {
      "source": "/products/:slug(oak-edged-boards|pine-construction-timber)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:locale(de|pl|uk)/products/:slug(oak-edged-boards|pine-construction-timber)",
      "destination": "/:locale",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
