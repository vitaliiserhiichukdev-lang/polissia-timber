# ---------------------------------------------------------------- client
# Where the quote form posts. A relative path keeps the build domain-agnostic.
# Leave unset and the form falls back to composing an email in the visitor's
# mail client (useful locally, unreliable in production).
VITE_CONTACT_ENDPOINT=/api/quote

# ------------------------------------------------- function (server) only
# Never prefix these with VITE_ — that would ship them in the client bundle.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
QUOTE_TO=export@polissia-timber.com
QUOTE_FROM=Polissia Timber <website@polissia-timber.com>
ALLOWED_ORIGIN=https://polissia-timber.com
